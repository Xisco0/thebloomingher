# TheBloomingHer Care & Wellness Environment Configuration

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://thebloomingher.com

# Paystack Payment Gateway Keys
# Public Key (Safe for client-side popups/scripts)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret Key (Strictly server-side ONLY - Never expose to frontend)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 Object Storage (Server-Side Only)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://87c7ac9ee04b439450ba16bb4a82c5b7.r2.cloudflarestorage.com
R2_BUCKET_NAME=thebloomingher-media
# Optional: Public R2 custom domain or r2.dev subdomain (e.g. https://media.thebloomingher.com)
# If left blank, the application automatically uses the secure Next.js image proxy (/api/images/...)
R2_PUBLIC_URL=

# WhatsApp Concierge Support Number (International Format)
NEXT_PUBLIC_WHATSAPP_NUMBER=+2348103641002
